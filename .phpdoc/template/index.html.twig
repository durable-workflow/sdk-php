{% extends 'base.html.twig' %}

{% block title %}PHP SDK API Reference{% endblock %}

{% block content %}
<article class="php-quickstart">
    <header class="php-quickstart__hero">
        <p class="php-quickstart__eyebrow">Generated reference</p>
        <h2>PHP SDK API Reference</h2>
        <p>Browse exact classes, methods, models, attributes, bridge types, and exceptions after choosing the right concept in the authored guides.</p>
        <nav class="php-quickstart__path-nav" aria-label="API reference destinations">
            <a href="/">PHP SDK home</a>
            <a href="/getting-started/first-workflow/">First workflow</a>
            <a href="/build/workflows-activities/">Concept guides</a>
        </nav>
    </header>

    <section class="php-quickstart__section php-quickstart__reference">
        <h3>Browse symbols</h3>
        {% set node = project.namespace %}
        {{
        include(
            'components/table-of-contents.html.twig',
            {
                'node': project.namespace,
                'namespaces': usesNamespaces or not usesPackages ? node.children : [],
                'packages': usesPackages ? project.package.children : []
            }
        )
        }}
        {{ include('components/constants.html.twig', {'node': project.namespace}) }}
        {{ include('components/functions.html.twig', {'node': project.namespace}) }}
    </section>
</article>
{% endblock %}
