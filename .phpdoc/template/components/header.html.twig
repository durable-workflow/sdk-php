<header class="phpdocumentor-header phpdocumentor-section">
    {% include 'components/header-title.html.twig' %}
    {% set hasTopMenu = topMenu|default([])|filter(menu => menu|length > 0)|length > 0 %}
    {% if hasTopMenu %}
        <input class="phpdocumentor-header__menu-button" type="checkbox" id="menu-button" name="menu-button" />
        <label class="phpdocumentor-header__menu-icon" for="menu-button">
            <i class="fas fa-bars"></i>
        </label>
    {% endif %}
    {{ include('components/search.html.twig') }}
    {% if hasTopMenu %}
        {% include 'components/topnav.html.twig' %}
    {% endif %}
</header>
<aside
    class="dw-cloud-promotion"
    aria-labelledby="dw-cloud-promotion-title"
    data-promotion-source="sdk-php-reference">
    <div>
        <p class="dw-cloud-promotion__eyebrow">Managed PHP runtime · limited cohort</p>
        <h2 id="dw-cloud-promotion-title">Durable Workflow Cloud launch cohort</h2>
        <p>Run PHP clients and workers against a managed namespace while Durable Workflow operates the orchestration runtime.</p>
    </div>
    <a
        class="dw-cloud-promotion__action"
        data-promotion-action="early-access"
        href="https://cloud.durable-workflow.com/early-access#source=sdk-php-reference">Request early access</a>
</aside>
