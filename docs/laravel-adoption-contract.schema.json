{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://php.durable-workflow.com/laravel-adoption-contract.schema.json",
  "title": "Durable Workflow Laravel adoption contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "framework",
    "embedded_transition_authority",
    "modes",
    "transitions",
    "continuity",
    "representative_journey",
    "saga_journey",
    "qualification"
  ],
  "properties": {
    "$schema": {"const": "https://php.durable-workflow.com/laravel-adoption-contract.schema.json"},
    "schema_version": {"const": 1},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "constraint", "php_constraint", "qualification_matrix"],
      "properties": {
        "package": {"const": "laravel/framework"},
        "constraint": {"type": "string", "minLength": 1},
        "php_constraint": {"type": "string", "minLength": 1},
        "qualification_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["laravel", "php", "package", "bootstrap"],
            "properties": {
              "laravel": {"type": "string", "pattern": "^[0-9]+$"},
              "php": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
              "package": {"type": "string", "pattern": "^laravel/framework:\\^[0-9]+\\.0$"},
              "bootstrap": {"enum": ["existing_supported_lock", "fresh_supported_install"]}
            }
          }
        }
      }
    },
    "embedded_transition_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "manifest", "schema", "version"],
      "properties": {
        "package": {"const": "durable-workflow/workflow"},
        "manifest": {"const": "resources/laravel-embedded-upgrade-contract.json"},
        "schema": {"const": "durable-workflow.laravel-embedded-upgrade.contract"},
        "version": {"const": 1}
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedded_v1", "embedded_v2", "service_v2"],
      "properties": {
        "embedded_v1": {"$ref": "#/$defs/mode"},
        "embedded_v2": {"$ref": "#/$defs/mode"},
        "service_v2": {"$ref": "#/$defs/mode"}
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/embedded_transition"},
          {"$ref": "#/$defs/service_transition"}
        ]
      }
    },
    "continuity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "required_action"],
        "properties": {
          "surface": {
            "enum": [
              "workflow_type",
              "workflow_id",
              "task_queue",
              "payload",
              "memo_search_metadata",
              "signals_updates",
              "rollback"
            ]
          },
          "required_action": {
            "enum": [
              "map_explicitly",
              "route_to_one_authority",
              "bind_worker_and_starter",
              "translate_and_validate",
              "repopulate_for_new_runs",
              "quiesce_then_switch_ingress",
              "keep_runtime_specific"
            ]
          }
        }
      }
    },
    "representative_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_type",
        "activity_type",
        "input",
        "result",
        "service_dependency",
        "application_client",
        "application_fake",
        "start_shape",
        "assertion_shape"
      ],
      "properties": {
        "workflow_type": {"const": "laravel.greeting"},
        "activity_type": {"const": "laravel.greet"},
        "input": {"type": "array"},
        "result": {},
        "service_dependency": {"type": "string", "minLength": 1},
        "application_client": {
          "const": "DurableWorkflow\\Bridge\\Laravel\\LaravelWorkflowClientInterface"
        },
        "application_fake": {
          "const": "DurableWorkflow\\Bridge\\Laravel\\Testing\\LaravelWorkflowClientFake"
        },
        "start_shape": {"const": "attributed_service_class"},
        "assertion_shape": {"const": "attributed_service_class"}
      }
    },
    "saga_journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_type",
        "forward_activity_types",
        "compensation_activity_types",
        "authoring_surface",
        "context_factory",
        "typed_failure",
        "application_fake",
        "compensation_order",
        "durable_state",
        "cross_language_activity_binding"
      ],
      "properties": {
        "workflow_type": {"const": "laravel.compensated-trip"},
        "forward_activity_types": {
          "const": ["trip.reserve-flight", "trip.reserve-hotel", "trip.charge"]
        },
        "compensation_activity_types": {
          "const": ["trip.cancel-hotel", "trip.cancel-flight"]
        },
        "authoring_surface": {"const": "DurableWorkflow\\Worker\\Saga"},
        "context_factory": {"const": "DurableWorkflow\\Worker\\WorkflowContext::saga"},
        "typed_failure": {"const": "DurableWorkflow\\Exception\\SagaCompensationFailed"},
        "application_fake": {
          "const": "DurableWorkflow\\Bridge\\Laravel\\Testing\\LaravelWorkflowClientFake"
        },
        "compensation_order": {"const": "reverse_registration"},
        "durable_state": {"const": "ordinary_activity_history"},
        "cross_language_activity_binding": {"const": true}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedded", "service", "established_application_transitions"],
      "properties": {
        "embedded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "targets"],
          "properties": {
            "owner": {"const": "durable-workflow/workflow"},
            "targets": {"const": ["local_laravel_runtime"]}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "targets",
            "published_artifacts_required",
            "saga_cross_language_activities_required",
            "saga_replay_required"
          ],
          "properties": {
            "owner": {"const": "durable-workflow/sdk"},
            "targets": {"const": ["standalone_server", "managed_cloud"]},
            "published_artifacts_required": {"const": true},
            "saga_cross_language_activities_required": {"const": true},
            "saga_replay_required": {"const": true}
          }
        },
        "established_application_transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "clean_application_required",
            "same_injected_dependency_required",
            "source_history_must_remain_owned",
            "new_service_starts_required"
          ],
          "properties": {
            "sources": {"const": ["embedded_v1", "embedded_v2"]},
            "clean_application_required": {"const": true},
            "same_injected_dependency_required": {"const": true},
            "source_history_must_remain_owned": {"const": true},
            "new_service_starts_required": {"const": true}
          }
        }
      }
    }
  },
  "$defs": {
    "embedded_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "authority"],
      "properties": {
        "id": {"const": "v1_to_v2_embedded"},
        "from": {"const": "embedded_v1"},
        "to": {"const": "embedded_v2"},
        "authority": {"const": "embedded_transition_authority"}
      }
    },
    "service_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "ownership_change",
        "open_run_policies",
        "history_disposition",
        "rollback_boundary"
      ],
      "properties": {
        "id": {"enum": ["v1_to_v2_service", "v2_embedded_to_v2_service"]},
        "from": {"enum": ["embedded_v1", "embedded_v2"]},
        "to": {"const": "service_v2"},
        "ownership_change": {"const": true},
        "open_run_policies": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["drain", "coexist_by_runtime"]},
          "uniqueItems": true
        },
        "history_disposition": {"const": "explicit_state_migration_required"},
        "rollback_boundary": {"const": "per_runtime"}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "channel", "state_owner"],
      "properties": {
        "package": {"enum": ["durable-workflow/workflow", "durable-workflow/sdk"]},
        "channel": {"enum": ["^1.0", "^2.0"]},
        "state_owner": {"enum": ["laravel_application", "server_or_cloud"]}
      }
    }
  }
}
